# ==============================================================================
# Environment Variables for AI Evaluation Platform
# ==============================================================================

# LLM API Authentication (Anthropic / DeepSeek / Kimi Proxy)
ANTHROPIC_API_KEY=sk-your-anthropic-or-deepseek-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Web Search API (Optional)
BOCHA_API_KEY=sk-your-bocha-search-key

# OpenTelemetry Tracing (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eval-agent-sdk
